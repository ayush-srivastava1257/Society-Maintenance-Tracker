PORT=5000
DATABASE_URL="file:./dev.db"
JWT_SECRET="nestgrid_super_secret_jwt_key_2026_change_in_production"
JWT_EXPIRES_IN="7d"
NODE_ENV="development"

# Email Configuration (Optional - falls back to dev console logger if omitted)
SMTP_HOST="smtp.example.com"
SMTP_PORT=587
SMTP_USER="notifications@nestgrid.app"
SMTP_PASS="secret_password"
EMAIL_FROM="NestGrid Notifications <notifications@nestgrid.app>"

# Overdue SLA Default Threshold (in days)
DEFAULT_OVERDUE_THRESHOLD_DAYS=3
